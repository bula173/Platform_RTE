# safeAPIFrameworkConfig.cmake
# Provides real IMPORTED targets and CMake helpers for projects using
# safeAPIFramework via find_package().
#
# Usage:
#   find_package(safeAPIFramework REQUIRED)
#   target_link_libraries(myapp PRIVATE safeapi::core safeapi::oal)
#   # (safeapi::channels / safeapi::appmanager also available, depending on
#   # which SAFEAPI_ENABLE_* options this package was built with - see
#   # safeAPIFramework_INCLUDE_DIR/_LIB_DIR below if you need the raw paths,
#   # and include(SafeAPIHelpers) for sapi_enable_cppcheck_misra() etc.)

get_filename_component(_safeAPIFramework_DIR "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
# This file installs to
# <prefix>/dist/<platform>[/<channel>]/lib/cmake/safeAPIFramework/ -
# dist/<platform>/ is the SAPI-wide "what this project hands to another
# project, per architecture" convention (root CLAUDE.md), and ADR-008
# channel builds (-DSAPI_CHANNEL_BUILD_ID=A|B) add one more directory level
# below that (dist/<platform>/A/, dist/<platform>/B/ - see
# safeAPIFreamwork/CMakeLists.txt's own SAFEAPI_DIST_SUBPATH doc). The
# number of '..' needed to reach <prefix> therefore isn't fixed - it's
# baked in below as SAFEAPI_CONFIG_PREFIX_RELPATH, computed at
# configure_file() time from the actual nesting depth THIS package was
# installed under, rather than hardcoded here for only one of the two
# cases (a wrong depth would break safeAPIFramework_INCLUDE_DIR/_LIB_DIR
# for every find_package() consumer, silently resolving to the wrong
# directory instead of failing loudly).
get_filename_component(_safeAPIFramework_PREFIX "${_safeAPIFramework_DIR}/@SAFEAPI_CONFIG_PREFIX_RELPATH@" ABSOLUTE)

# Baked in at configure_file() time from the same SAFEAPI_DIST_SUBPATH
# this package was actually installed under (CMAKE_SYSTEM_NAME-
# CMAKE_SYSTEM_PROCESSOR[/channel] of the build that produced THIS config
# file) - this file never re-detects the running consumer's own
# platform/channel, since a consumer configuring for a different one than
# this package was built for is exactly the case find_package() should
# fail on, not paper over.
set(_safeAPIFramework_dist_subpath "@SAFEAPI_DIST_SUBPATH@")

# Make shared CMake modules available to downstream projects
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Expose install paths for downstream use (raw paths, for anything that
# doesn't just want to link the imported targets below)
set(safeAPIFramework_INCLUDE_DIR "${_safeAPIFramework_PREFIX}/dist/${_safeAPIFramework_dist_subpath}/include")
set(safeAPIFramework_LIB_DIR "${_safeAPIFramework_PREFIX}/dist/${_safeAPIFramework_dist_subpath}/lib")

# Real IMPORTED targets: safeapi::core, safeapi::oal, safeapi::channels, and
# safeapi::appmanager if it was enabled at build time (ADR-024
# SAFEAPI_ENABLE_APPMANAGER) - generated by this project's own
# install(EXPORT safeAPIFrameworkTargets ...) call, so include directories,
# transitive link dependencies, and compile requirements all come along
# automatically. This replaces the old safeAPIFramework_LIBRARIES variable,
# which listed 12 stale pre-ADR-023 per-feature library names and required
# manual linking against raw archive names with no transitive dependency
# information.
include("${CMAKE_CURRENT_LIST_DIR}/safeAPIFrameworkTargets.cmake")

set(_safeAPIFramework_targets "safeapi::core safeapi::oal safeapi::channels")
if(TARGET safeapi::appmanager)
    string(APPEND _safeAPIFramework_targets " safeapi::appmanager")
endif()

message(STATUS "safeAPIFramework found:")
message(STATUS "  Include dir: ${safeAPIFramework_INCLUDE_DIR}")
message(STATUS "  Lib dir: ${safeAPIFramework_LIB_DIR}")
message(STATUS "  Targets: ${_safeAPIFramework_targets}")
message(STATUS "  Use 'include(SafeAPIHelpers)' for helper functions")
