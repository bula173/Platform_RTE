# RteFrameworkConfig.cmake
# Provides real IMPORTED targets and CMake helpers for projects using
# RteFramework via find_package().
#
# Usage:
#   find_package(RteFramework REQUIRED)
#   target_link_libraries(myapp PRIVATE rte::core rte::oal)
#   # (rte::channels / rte::appmanager also available, depending on
#   # which RTE_ENABLE_* options this package was built with - see
#   # RteFramework_INCLUDE_DIR/_LIB_DIR below if you need the raw paths,
#   # and include(RTEHelpers) for rte_enable_cppcheck_misra() etc.)

get_filename_component(_RteFramework_DIR "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
# This file installs to
# <prefix>/dist/<platform>[/<channel>]/lib/cmake/RteFramework/ -
# dist/<platform>/ is the SAPI-wide "what this project hands to another
# project, per architecture" convention (root CLAUDE.md), and ADR-008
# channel builds (-DRTE_CHANNEL_BUILD_ID=A|B) add one more directory level
# below that (dist/<platform>/A/, dist/<platform>/B/ - see
# safeAPIFreamwork/CMakeLists.txt's own RTE_DIST_SUBPATH doc). The
# number of '..' needed to reach <prefix> therefore isn't fixed - it's
# baked in below as RTE_CONFIG_PREFIX_RELPATH, computed at
# configure_file() time from the actual nesting depth THIS package was
# installed under, rather than hardcoded here for only one of the two
# cases (a wrong depth would break RteFramework_INCLUDE_DIR/_LIB_DIR
# for every find_package() consumer, silently resolving to the wrong
# directory instead of failing loudly).
get_filename_component(_RteFramework_PREFIX "${_RteFramework_DIR}/@RTE_CONFIG_PREFIX_RELPATH@" ABSOLUTE)

# Baked in at configure_file() time from the same RTE_DIST_SUBPATH
# this package was actually installed under (CMAKE_SYSTEM_NAME-
# CMAKE_SYSTEM_PROCESSOR[/channel] of the build that produced THIS config
# file) - this file never re-detects the running consumer's own
# platform/channel, since a consumer configuring for a different one than
# this package was built for is exactly the case find_package() should
# fail on, not paper over.
set(_RteFramework_dist_subpath "@RTE_DIST_SUBPATH@")

# Make shared CMake modules available to downstream projects
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Expose install paths for downstream use (raw paths, for anything that
# doesn't just want to link the imported targets below)
set(RteFramework_INCLUDE_DIR "${_RteFramework_PREFIX}/dist/${_RteFramework_dist_subpath}/include")
set(RteFramework_LIB_DIR "${_RteFramework_PREFIX}/dist/${_RteFramework_dist_subpath}/lib")

# Baked in from the SAME RTE_FRAMEWORK_VERSION CACHE variable this
# package's own build computed (scripts/compute_version.sh) - lets a
# consumer using find_package() (RTE_USE_INSTALLED_FRAMEWORK=ON) read
# "what version did I configure against" without parsing any header, the
# same way an add_subdirectory() consumer reads the CACHE variable
# directly (see safeAPIRBC2oo2/CMakeLists.txt's own
# RTE_FRAMEWORK_EXPECTED_VERSION for why this matters - the runtime
# startup version-match check both paths ultimately feed).
set(RteFramework_VERSION "@RTE_FRAMEWORK_VERSION@")

# Real IMPORTED targets: rte::core, rte::oal, rte::channels, and
# rte::appmanager if it was enabled at build time (ADR-024
# RTE_ENABLE_APPMANAGER) - generated by this project's own
# install(EXPORT RteFrameworkTargets ...) call, so include directories,
# transitive link dependencies, and compile requirements all come along
# automatically. This replaces the old RteFramework_LIBRARIES variable,
# which listed 12 stale pre-ADR-023 per-feature library names and required
# manual linking against raw archive names with no transitive dependency
# information.
include("${CMAKE_CURRENT_LIST_DIR}/RteFrameworkTargets.cmake")

# RteFrameworkTargets.cmake (CMake's own install(EXPORT ...) boilerplate)
# computes its own _IMPORT_PREFIX by walking a FIXED number of parent
# directories up from its own location - that fixed depth assumes the
# standard <prefix>/lib/cmake/<pkg>/ layout and does not know about this
# project's own EXTRA dist/<platform>[/<channel-or-libc>]/ nesting level(s)
# (see RTE_DIST_SUBPATH in the top-level CMakeLists.txt), so its
# INTERFACE_INCLUDE_DIRECTORIES silently resolves one or more levels too
# high - found live: a fresh consumer build failed with a header genuinely
# missing from RteFramework_INCLUDE_DIR (computed correctly, just
# above) but NOT from wherever the imported targets' own include dirs
# actually pointed, which turned out to be this project's SOURCE tree
# (`safeAPIFreamwork/include`, coincidentally still reachable and - until
# now - containing an IDENTICAL copy of every header that also happens to
# exist in the dist/ tree, since dist/ is populated FROM source; a header
# that exists ONLY in dist/ - like rte_core_version.h, generated at
# configure time - was the first thing to expose the gap). Fixed by
# overriding each imported target's include dirs with the SAME correctly-
# computed RteFramework_INCLUDE_DIR above, rather than trusting
# Targets.cmake's own possibly-wrong computation.
foreach(_RteFramework_imported_target core oal channels appmanager)
    if(TARGET rte::${_RteFramework_imported_target})
        set_target_properties(rte::${_RteFramework_imported_target} PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${RteFramework_INCLUDE_DIR}"
        )
    endif()
endforeach()

set(_RteFramework_targets "rte::core rte::oal rte::channels")
if(TARGET rte::appmanager)
    string(APPEND _RteFramework_targets " rte::appmanager")
endif()

message(STATUS "RteFramework found:")
message(STATUS "  Include dir: ${RteFramework_INCLUDE_DIR}")
message(STATUS "  Lib dir: ${RteFramework_LIB_DIR}")
message(STATUS "  Targets: ${_RteFramework_targets}")
message(STATUS "  Use 'include(RTEHelpers)' for helper functions")
