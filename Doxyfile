PROJECT_NAME           = "Safe API Framework"
PROJECT_NUMBER         = $(PROJECT_NUMBER)  # set by docs.yml / a local build: "<VERSION file> build <short-sha>"
PROJECT_BRIEF          = "Layered API framework for safety-related applications (ERTMS RBC reference targeting CENELEC EN 50128 SIL 4)"
OUTPUT_DIRECTORY       = docs/api
INPUT                  = README.md include src docs/architecture docs/CROSS_COMPILATION.md docs/requirements docs/MODULES.md docs/REDUNDANCY_ARCHITECTURE.md
FILE_PATTERNS          = *.h *.c *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO

EXTRACT_ALL             = NO
EXTRACT_STATIC          = YES
EXTRACT_PRIVATE         = NO
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_NO_PARAMDOC        = YES

OPTIMIZE_OUTPUT_FOR_C   = YES
TYPEDEF_HIDES_STRUCT    = YES
SORT_MEMBER_DOCS        = NO
SOURCE_BROWSER          = YES

# Custom HTML Header & Mermaid.js support
HTML_HEADER            = docs/doxygen_header.html
HTML_EXTRA_FILES       = docs/doxygen_mermaid.js

# Graphviz Dot & PlantUML diagram support
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
PLANTUML_JAR_PATH      = $(PLANTUML_JAR_PATH)

ALIASES                += "safety=\par Safety:^^"
ALIASES                += "req{1}=\par Requirement:\n\1"
