{
  "version": 3,
  "vendor": {
    "rte": {
      "description": "Safe API Framework - CMake presets for MISRA C:2012 / SIL 3/4 builds"
    }
  },
  "configurePresets": [
    {
      "name": "default",
      "description": "Default debug configuration",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "description": "Debug build with all warnings and tests enabled",
      "inherits": "default",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RTE_BUILD_TESTS": "ON",
        "RTE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "description": "Release build (optimized, warnings as errors)",
      "inherits": "default",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RTE_BUILD_TESTS": "ON",
        "RTE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci",
      "description": "CI build - strict warnings, tests, and static analysis",
      "inherits": "debug",
      "displayName": "CI",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "asan",
      "description": "AddressSanitizer build for memory error detection",
      "inherits": "debug",
      "displayName": "ASAN (Debug with AddressSanitizer)",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "ubsan",
      "description": "UndefinedBehaviorSanitizer build",
      "inherits": "debug",
      "displayName": "UBSAN (Debug with UndefinedBehaviorSanitizer)",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=undefined",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined"
      }
    },
    {
      "name": "coverage",
      "description": "Code coverage build (for lcov/gcov)",
      "inherits": "debug",
      "displayName": "Coverage",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "--coverage",
        "CMAKE_CXX_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "clang",
      "description": "Clang/LLVM compiler build",
      "inherits": "debug",
      "displayName": "Debug (Clang)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "gcc",
      "description": "GCC compiler build",
      "inherits": "debug",
      "displayName": "Debug (GCC)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "minimal",
      "description": "Minimal build without tests (headers only verification)",
      "inherits": "default",
      "displayName": "Minimal (no tests)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RTE_BUILD_TESTS": "OFF",
        "RTE_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "linux-native",
      "description": "Native Linux build (POSIX OAL)",
      "inherits": "debug",
      "displayName": "Linux (Native)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/Toolchain-Linux.cmake"
      }
    },
    {
      "name": "linux-release",
      "description": "Linux release build (optimized)",
      "inherits": "release",
      "displayName": "Linux (Release)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/Toolchain-Linux.cmake"
      }
    },
    {
      "name": "qnx",
      "description": "QNX RTOS target build (requires QNX_HOST and QNX_TARGET environment variables)",
      "inherits": "debug",
      "displayName": "QNX RTOS",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/Toolchain-QNX.cmake",
        "RTE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "qnx-release",
      "description": "QNX RTOS release build",
      "inherits": "release",
      "displayName": "QNX RTOS (Release)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/Toolchain-QNX.cmake",
        "RTE_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "description": "Build debug configuration",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "release",
      "description": "Build release configuration",
      "jobs": 0
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "description": "Build for CI",
      "jobs": 0
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "description": "Build with AddressSanitizer",
      "jobs": 0
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "description": "Build with UndefinedBehaviorSanitizer",
      "jobs": 0
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "description": "Build with coverage instrumentation",
      "jobs": 0
    },
    {
      "name": "clang",
      "configurePreset": "clang",
      "description": "Build with Clang",
      "jobs": 0
    },
    {
      "name": "gcc",
      "configurePreset": "gcc",
      "description": "Build with GCC",
      "jobs": 0
    },
    {
      "name": "linux-native",
      "configurePreset": "linux-native",
      "description": "Build for native Linux (POSIX OAL)",
      "jobs": 0
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "description": "Build for Linux release",
      "jobs": 0
    },
    {
      "name": "qnx",
      "configurePreset": "qnx",
      "description": "Build for QNX RTOS",
      "jobs": 0
    },
    {
      "name": "qnx-release",
      "configurePreset": "qnx-release",
      "description": "Build for QNX RTOS release",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "description": "Run tests (debug build)",
      "inherits": "default"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "description": "Run tests (release build)",
      "inherits": "default"
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "description": "Run tests for CI",
      "inherits": "default",
      "execution": {
        "stopOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "description": "Run tests with AddressSanitizer",
      "inherits": "default"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "description": "Run tests with UndefinedBehaviorSanitizer",
      "inherits": "default"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "description": "Run tests with coverage",
      "inherits": "default"
    },
    {
      "name": "linux-native",
      "configurePreset": "linux-native",
      "description": "Run tests (Linux native)",
      "inherits": "default"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "description": "Run tests (Linux release)",
      "inherits": "default"
    }
  ]
}
